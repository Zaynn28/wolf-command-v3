{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "rootDir": "src",
    "types": ["node"],
    "typeRoots": ["../../apps/wolf/node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
